#!/bin/bash
# mpremote wrapper for the frame board. Usage: ./mpr <mpremote args...>
# Override the port with: PORT=/dev/cu.xxx ./mpr ...
HERE="$(cd "$(dirname "$0")" && pwd)"
PORT="${PORT:-$(ls /dev/cu.usbmodem* 2>/dev/null | grep -v 1234561 | head -1)}"
[ -n "$PORT" ] || { echo "No board found. Plug the UART port in, or set PORT=..." >&2; exit 1; }
exec "$HERE/venv/bin/mpremote" connect "$PORT" "$@"
